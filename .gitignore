# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must ship, or a fresh clone has nothing to copy. It holds
# only the publishable key, which is public by design — RLS is the gate.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Build output of the guide render stage. `scripts/render-guide.py` regenerates it from
# `stage.ts` on every run, so a committed copy could only ever be a stale duplicate.
/scripts/guide-stage/stage.js

# The guide's intermediate films: the silent picture and the picture-plus-voice, one of each
# per audience. `scripts/{render,voice,music}-guide.py` produce them in that order and only
# the last output ships, so these are derived, large (110 MB) and deliberately not committed.
# They live outside `public/` because everything under it is uploaded to the CDN.
/.guide-masters/

# Python bytecode from the guide render scripts. `voice-guide.py` and `captions-guide.py`
# import `render-guide.py` through `importlib`, which writes one of these next to it.
__pycache__/

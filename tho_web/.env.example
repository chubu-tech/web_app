# The `bsalons` project — the same database the Flutter app and the operator
# console use. This app is a client of it; it owns no schema.
#
# The publishable (anon) key is safe in a browser: Row-Level Security is the
# gate, and every write goes through a SECURITY DEFINER RPC that authorises the
# caller itself.
#
# There is no service-role key here and there must never be one. This app acts
# only as its signed-in user — that is the whole security model.
NEXT_PUBLIC_SUPABASE_URL=https://izlyevebmxqlxinigote.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Ve9ENI8gAovucWDHRzKuRg_TaVW_Uhe
